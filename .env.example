# 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 비워두면 로컬 PGlite(data/pgdata) + 로컬 파일 저장소(data/objects)로 실행됩니다.

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (포트 6543)
# 예: postgresql://postgres.<project-ref>:<DB 비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase > Project Settings > API
SUPABASE_URL=
# service_role 키: 서버 전용. 브라우저·클라이언트 코드·git에 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# 비공개 파일 버킷 이름 (npm run db:migrate 가 없으면 비공개로 생성)
SUPABASE_BUCKET=private-files

# Vercel Cron 이 /api/cron/cleanup 호출 시 사용하는 비밀값 (Vercel이 Authorization 헤더로 자동 전송)
CRON_SECRET=

# 선택 설정
# PORT=3000
# STUDENT_SESSION_MAX_H=168
# STUDENT_SESSION_IDLE_H=24
# STAFF_SESSION_MAX_H=12
# STAFF_SESSION_IDLE_H=2
# MAX_ATTACHMENT_MB=20
# MAX_ROSTER_MB=10
# MAX_ROSTER_ROWS=5000
# LOGIN_MAX_FAILURES=10
